{
  "name": "pesticidenext",
  "version": "1.0.0",
  "description": "PesticideNext \u2014 bilingual (Bangla/English) pesticide database, dosage calculator and MoA rotation planner for Bangladeshi agriculture",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "validate:registry": "python3 scripts/validate_registry.py",
    "validate:registry:check": "python3 scripts/validate_registry.py --check",
    "integrate:registry": "python3 scripts/integrate_canonical_registry.py",
    "integrate:registry:check": "python3 scripts/integrate_canonical_registry.py --check",
    "regenerate:runtime": "python3 scripts/generate_runtime_json.py",
    "compare:csv": "python3 scripts/compare_csv_to_live_db.py --csv data_raw/attached_source.csv --json public/downloads/pesticide_database.json --out /artifacts/diff_report.json",
    "compare:csv:check": "python3 scripts/compare_csv_to_live_db.py --csv data_raw/attached_source.csv --json public/downloads/pesticide_database.json --out /tmp/kilo2/diff_report.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.4"
  }
}
